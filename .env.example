# Production database is "serv_crafty" (dev uses "serv_crafty_dev"). URL-encode special chars in the password (@ -> %40, ! -> %21, % -> %25).
DATABASE_URL=postgres://ServCrafty:<url-encoded-password>@192.168.69.206:5432/serv_crafty
SECRET_KEY=change-me-to-a-random-string-of-at-least-32-chars
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
ADMIN_EMAIL=admin@example.com
PUBLIC_URL=https://servcrafty.joaquincabrerasimoes.com
# HTTPS is terminated by Cloudflare / a reverse proxy; the app itself listens on plain HTTP :8080
TRUST_PROXY=1
CURSEFORGE_API_KEY=

# Allow webhooks to target private/loopback/link-local addresses (SSRF protection is on by default)
# ALLOW_PRIVATE_WEBHOOKS=1
