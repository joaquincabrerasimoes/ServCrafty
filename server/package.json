{
  "name": "@servcrafty/server",
  "private": true,
  "version": "0.4.2",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "start:dev": "node --env-file-if-exists=../.env dist/index.js",
    "migrate": "tsx --env-file-if-exists=../.env src/db/migrate-cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/multipart": "^9.0.3",
    "@fastify/static": "^8.1.1",
    "@fastify/websocket": "^11.0.2",
    "@node-rs/argon2": "^2.0.2",
    "@simplewebauthn/server": "^13.1.1",
    "archiver": "^7.0.1",
    "dockerode": "^4.0.4",
    "fastify": "^5.2.1",
    "node-cron": "^3.0.3",
    "otplib": "^12.0.1",
    "pg": "^8.13.3",
    "qrcode": "^1.5.4",
    "tar": "^7.4.3",
    "ws": "^8.22.2",
    "yauzl": "^3.4.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.3",
    "@types/dockerode": "^3.3.34",
    "@types/node": "^22.13.1",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.11.11",
    "@types/qrcode": "^1.5.5",
    "@types/ws": "^8.5.14",
    "@types/yauzl": "^2.10.3",
    "tsx": "^4.19.2",
    "typescript": "~5.7.3"
  }
}
