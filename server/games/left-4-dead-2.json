{
  "schema": 1,
  "id": "left-4-dead-2",
  "name": "Left 4 Dead 2",
  "description": "Left 4 Dead 2 dedicated server (Steam app 222860, native Linux 32-bit srcds, anonymous login; no GSLT needed). Port 27015 carries the game (UDP) and RCON (TCP) and is mirrored. The server accepts direct connections (sv_allow_lobby_connect_only 0). Workshop addons are not handled (L4D2 addons are VPK files placed in left4dead2/addons); upload them with the Files tab.",
  "icon": "https://cdn.cloudflare.steamstatic.com/steam/apps/550/header.jpg",
  "steam": {
    "appId": 222860,
    "branch": "public",
    "betaPassword": null,
    "platform": "linux",
    "login": "anonymous"
  },
  "resources": {
    "memoryMb": 2048,
    "memoryMinMb": 1024,
    "cpu": 2,
    "diskMb": 12288
  },
  "ports": [
    {
      "id": "game",
      "label": "Game, query and RCON (UDP + TCP)",
      "protocol": "both",
      "containerPort": 27015,
      "mirror": true,
      "publish": true,
      "main": true
    }
  ],
  "variables": [
    {
      "key": "serverName",
      "label": "Server name",
      "description": "Name shown in the server browser (hostname convar).",
      "type": "string",
      "default": "ServCrafty L4D2 Server",
      "required": true,
      "min": 1,
      "max": 64,
      "group": "Server"
    },
    {
      "key": "serverPassword",
      "label": "Server password",
      "description": "Password players need to join (sv_password). Leave empty for a public server.",
      "type": "password",
      "default": "",
      "required": false,
      "max": 32,
      "pattern": "^[\\x21-\\x7e]*$",
      "group": "Access"
    },
    {
      "key": "rconPassword",
      "label": "RCON password",
      "description": "Remote console password (rcon_password), also needed by external admin tools. Leave empty to have one generated when the server is created (20 characters); managers can read and regenerate it in Settings.",
      "type": "password",
      "required": true,
      "min": 6,
      "max": 64,
      "generate": {
        "length": 20,
        "charset": "alnum"
      },
      "group": "Access"
    },
    {
      "key": "map",
      "label": "Starting map",
      "description": "Map the server starts on (for example c1m1_hotel, c2m1_highway, c5m1_waterfront, c8m1_apartment). The map must exist on the server.",
      "type": "string",
      "default": "c2m1_highway",
      "required": true,
      "pattern": "^[A-Za-z0-9_.-]+$",
      "group": "Game"
    },
    {
      "key": "gameMode",
      "label": "Game mode",
      "description": "mp_gamemode.",
      "type": "select",
      "default": "coop",
      "required": true,
      "options": [
        {
          "value": "coop",
          "label": "Campaign (coop)"
        },
        {
          "value": "realism",
          "label": "Realism"
        },
        {
          "value": "versus",
          "label": "Versus"
        },
        {
          "value": "survival",
          "label": "Survival"
        },
        {
          "value": "scavenge",
          "label": "Scavenge"
        }
      ],
      "group": "Game"
    },
    {
      "key": "difficulty",
      "label": "Difficulty",
      "description": "z_difficulty (coop and realism only).",
      "type": "select",
      "default": "Normal",
      "required": true,
      "options": [
        {
          "value": "Easy",
          "label": "Easy"
        },
        {
          "value": "Normal",
          "label": "Normal"
        },
        {
          "value": "Hard",
          "label": "Advanced"
        },
        {
          "value": "Impossible",
          "label": "Expert"
        }
      ],
      "group": "Game"
    },
    {
      "key": "maxPlayers",
      "label": "Max players",
      "description": "Maximum number of players (4 for coop, 8 for versus; extra slots need server plugins).",
      "type": "number",
      "default": 8,
      "required": true,
      "min": 1,
      "max": 18,
      "integer": true,
      "group": "Game"
    }
  ],
  "launch": {
    "cwd": "",
    "command": [
      "./srcds_run",
      "-game",
      "left4dead2",
      "-console",
      "-strictportbind",
      "-norestart",
      "-port",
      "{{ports.game}}",
      "-maxplayers",
      "{{maxPlayers}}",
      "+map",
      "{{map}}",
      "+mp_gamemode",
      "{{gameMode}}",
      "+z_difficulty",
      "{{difficulty}}",
      "+sv_allow_lobby_connect_only",
      "0",
      "+hostname",
      "{{serverName}}",
      "+log",
      "on",
      {
        "value": "+sv_password",
        "if": "serverPassword"
      },
      {
        "value": "{{serverPassword}}",
        "if": "serverPassword"
      },
      "+rcon_password",
      "{{rconPassword}}"
    ],
    "env": {}
  },
  "files": [],
  "stop": {
    "type": "stdin",
    "command": "quit",
    "timeoutSec": 30
  },
  "console": {
    "stdin": true
  },
  "ready": {
    "logRegex": "Connection to Steam servers successful|gameserver Steam ID"
  },
  "players": {
    "joinRegex": "\"(?<name>.+?)<\\d+><[^>]*><[^>]*>\" entered the game",
    "leaveRegex": "\"(?<name>.+?)<\\d+><[^>]*><[^>]*>\" disconnected"
  },
  "query": {
    "a2s": {
      "portId": "game"
    }
  },
  "workshop": null,
  "webui": [],
  "scripts": {}
}
