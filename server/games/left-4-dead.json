{
  "schema": 1,
  "id": "left-4-dead",
  "name": "Left 4 Dead",
  "description": "Left 4 Dead dedicated server (Steam app 222840, native Linux 32-bit srcds, anonymous login, no GSLT). Port 27015 carries the game (UDP) and RCON (TCP) and is mirrored so the Steam browser sees the right port. Commands typed in the panel console go to the server and stop uses the quit command. Server content under cfg/ and addons/ lives in the game directory, which the default backups exclude. The server accepts direct connections (sv_allow_lobby_connect_only 0).",
  "icon": "https://cdn.cloudflare.steamstatic.com/steam/apps/500/header.jpg",
  "steam": {
    "appId": 222840,
    "branch": "public",
    "betaPassword": null,
    "platform": "linux",
    "login": "anonymous"
  },
  "resources": {
    "memoryMb": 1024,
    "memoryMinMb": 512,
    "cpu": 1,
    "diskMb": 8192
  },
  "ports": [
    {
      "id": "game",
      "label": "Game, query and RCON (UDP + TCP)",
      "protocol": "both",
      "containerPort": 27015,
      "mirror": true,
      "publish": true,
      "main": true
    }
  ],
  "variables": [
    {
      "key": "serverName",
      "label": "Server name",
      "description": "Name shown in the server browser (hostname).",
      "type": "string",
      "default": "ServCrafty L4D Server",
      "required": true,
      "min": 1,
      "max": 64,
      "group": "Server"
    },
    {
      "key": "serverPassword",
      "label": "Server password",
      "description": "Password players need to join. Leave empty for a public server.",
      "type": "password",
      "default": "",
      "required": false,
      "max": 32,
      "pattern": "^[\\x21-\\x7e]*$",
      "group": "Access"
    },
    {
      "key": "rconPassword",
      "label": "RCON password",
      "description": "Remote console password (rcon_password). Leave empty to have one generated when the server is created (20 characters); managers can read and regenerate it in Settings.",
      "type": "password",
      "required": true,
      "min": 6,
      "max": 64,
      "generate": {
        "length": 20,
        "charset": "alnum"
      },
      "group": "Access"
    },
    {
      "key": "map",
      "label": "Starting map",
      "description": "Map the server starts on (for example l4d_hospital01_apartment, l4d_garage01_alleys, l4d_smalltown01_caves, l4d_airport01_greenhouse, l4d_farm01_hilltop). The map must exist on the server.",
      "type": "string",
      "default": "l4d_hospital01_apartment",
      "required": true,
      "pattern": "^[A-Za-z0-9_.-]+$",
      "group": "Game"
    },
    {
      "key": "gameMode",
      "label": "Game mode",
      "description": "mp_gamemode.",
      "type": "select",
      "default": "coop",
      "required": true,
      "options": [
        {
          "value": "coop",
          "label": "Campaign (coop)"
        },
        {
          "value": "versus",
          "label": "Versus"
        },
        {
          "value": "survival",
          "label": "Survival"
        }
      ],
      "group": "Game"
    },
    {
      "key": "difficulty",
      "label": "Difficulty",
      "description": "z_difficulty (campaign only).",
      "type": "select",
      "default": "Normal",
      "required": true,
      "options": [
        {
          "value": "Easy",
          "label": "Easy"
        },
        {
          "value": "Normal",
          "label": "Normal"
        },
        {
          "value": "Hard",
          "label": "Advanced"
        },
        {
          "value": "Impossible",
          "label": "Expert"
        }
      ],
      "group": "Game"
    },
    {
      "key": "maxPlayers",
      "label": "Max players",
      "description": "Maximum number of players.",
      "type": "number",
      "default": 8,
      "required": true,
      "min": 1,
      "max": 16,
      "integer": true,
      "group": "Game"
    }
  ],
  "launch": {
    "cwd": "",
    "command": [
      "./srcds_run",
      "-game",
      "left4dead",
      "-console",
      "-strictportbind",
      "-norestart",
      "-port",
      "{{ports.game}}",
      "-maxplayers",
      "{{maxPlayers}}",
      "+map",
      "{{map}}",
      "+mp_gamemode",
      "{{gameMode}}",
      "+z_difficulty",
      "{{difficulty}}",
      "+sv_allow_lobby_connect_only",
      "0",
      "+hostname",
      "{{serverName}}",
      "+log",
      "on",
      {
        "value": "+sv_password",
        "if": "serverPassword"
      },
      {
        "value": "{{serverPassword}}",
        "if": "serverPassword"
      },
      "+rcon_password",
      "{{rconPassword}}"
    ],
    "env": {}
  },
  "files": [],
  "stop": {
    "type": "stdin",
    "command": "quit",
    "timeoutSec": 30
  },
  "console": {
    "stdin": true
  },
  "ready": {
    "logRegex": "Connection to Steam servers successful|gameserver Steam ID"
  },
  "players": {
    "joinRegex": "\"(?<name>.+?)<\\d+><[^>]*><[^>]*>\" entered the game",
    "leaveRegex": "\"(?<name>.+?)<\\d+><[^>]*><[^>]*>\" disconnected"
  },
  "query": {
    "a2s": {
      "portId": "game"
    }
  },
  "workshop": null,
  "webui": [],
  "scripts": {}
}
