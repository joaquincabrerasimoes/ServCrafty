{
  "schema": 1,
  "id": "test-game",
  "name": "Test Game",
  "description": "Fixture used by the unit tests.",
  "icon": null,
  "steam": { "appId": 123456, "branch": null, "betaPassword": null, "platform": "linux", "login": "anonymous" },
  "resources": { "memoryMb": 4096, "memoryMinMb": 1024, "cpu": 2, "diskMb": 10240 },
  "ports": [
    { "id": "game", "label": "Game", "protocol": "both", "containerPort": 7777, "main": true },
    { "id": "query", "label": "Query", "protocol": "udp", "containerPort": 27015, "mirror": true },
    { "id": "web", "label": "Web admin", "protocol": "tcp", "containerPort": 8080, "publish": false }
  ],
  "variables": [
    { "key": "serverName", "label": "Server name", "type": "string", "default": "My server", "required": true, "max": 64, "group": "Server" },
    { "key": "maxPlayers", "label": "Max players", "type": "number", "default": 8, "min": 1, "max": 64, "integer": true, "group": "Server" },
    { "key": "password", "label": "Password", "type": "password", "default": "", "group": "Security" },
    { "key": "adminPassword", "label": "Admin password", "type": "password", "default": "changeme", "required": true, "group": "Security" },
    { "key": "pvp", "label": "PvP", "type": "boolean", "default": false, "valueMap": { "true": "True", "false": "False" } },
    { "key": "mode", "label": "Mode", "type": "select", "default": "coop", "options": [ { "value": "coop", "label": "Co-op" }, { "value": "versus", "label": "Versus" } ] },
    { "key": "mapList", "label": "Maps", "type": "string", "default": "a,b" }
  ],
  "launch": {
    "cwd": "bin",
    "command": [
      "./server.sh",
      "-Port={{ports.game}}",
      "-QueryPort={{ports.query}}",
      { "value": "-Password={{password}}", "if": "password" },
      "-Name={{serverName}}",
      "-PvP={{pvp}}"
    ],
    "env": { "SERVER_ID": "{{server.id}}" }
  },
  "files": [
    { "type": "template", "path": "Config/server.cfg", "content": "name={{serverName}}\nmax={{maxPlayers}}\nmode={{mode}}\n", "when": "always" },
    {
      "type": "ini",
      "path": "Config/Engine.ini",
      "when": "always",
      "set": [ { "section": "Engine.GameInfo", "key": "MaxPlayers", "value": "{{maxPlayers}}" } ],
      "list": [
        { "section": "OnlineSubsystemSteamworks.KFWorkshopSteamworks", "key": "ServerSubscribedWorkshopItems", "valuesFrom": "workshop" },
        { "section": "Maps", "key": "Map", "valuesFrom": "var:mapList" }
      ]
    }
  ],
  "stop": { "type": "stdin", "command": "quit", "timeoutSec": 30 },
  "console": { "stdin": true },
  "ready": { "logRegex": "Server is ready" },
  "players": { "joinRegex": "Player (?<name>\\S+) joined", "leaveRegex": "Player (?<name>\\S+) left" },
  "query": { "a2s": { "portId": "query" } },
  "workshop": { "appId": 232090, "install": "config-list" },
  "webui": [
    { "id": "webadmin", "label": "Web admin", "portId": "web", "path": "/ServerAdmin/", "auth": { "type": "basic", "user": "admin", "password": "{{adminPassword}}" }, "minAccess": "manager", "rewrite": true }
  ],
  "scripts": { "postInstall": "echo installed", "preStart": "echo starting" }
}
